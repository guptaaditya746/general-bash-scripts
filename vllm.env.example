# Copy to config/vllm.env on the cluster and adjust for your allocation.
MODEL_CHAT=Qwen/Qwen3.5-9B
MAX_MODEL_LEN=16384
GPU_MEM_UTIL_CHAT=0.85
CHAT_DTYPE=auto
VLLM_ENGINE_READY_TIMEOUT_S=1800
VLLM_HEALTH_POLL_INTERVAL_S=5
VLLM_RUN_SMOKE_TESTS=1
PREFETCH_MODELS=1
PARTITION=gpu
GRES=gpu:3g.20gb:1
CPUS_PER_TASK=8
MEMORY=32G
TIME_LIMIT=24:00:00
